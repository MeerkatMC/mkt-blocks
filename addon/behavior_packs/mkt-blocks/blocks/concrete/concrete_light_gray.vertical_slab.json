{
	"format_version": "1.21.130",
	"minecraft:block": {
		"description": {
			"identifier": "mkt:concrete_light_gray_vertical_slab",
			"menu_category": {
				"category": "construction",
				"group": "minecraft:itemGroup.name.slab"
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			}
		},
		"components": {
			"minecraft:collision_box": {
				"origin": [-8, 0, 0],
				"size": [16, 16, 8]
			},
			"minecraft:selection_box": {
				"origin": [-8, 0, 0],
				"size": [16, 16, 8]
			},
			"minecraft:liquid_detection": {
				"detection_rules": [
					{ 
						"can_contain_liquid": true,
						"liquid_type": "water",
						"on_liquid_touches": "blocking"
					}
				]
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 1.0,
				"item_specific_speeds": [
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:wooden_tier')" },
					"destroy_speed": 0.8
				  },
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:stone_tier')" },
					"destroy_speed": 0.75
				  },
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:iron_tier')" },
					"destroy_speed": 0.5
				  },
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:golden_tier')" },
					"destroy_speed": 0.75
				  },
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:diamond_tier')" },
					"destroy_speed": 0.38
				  },
				  {
					"item": { "tags": "q.all_tags('minecraft:is_pickaxe', 'minecraft:netherite_tier')" },
					"destroy_speed": 0.31
				  }
				]	
			},
			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 30
			},
			"minecraft:geometry": "geometry.mkt.vertical_slab",
			"minecraft:material_instances": {
				"*": {
					"texture": "concrete_slab_light_gray",
					"render_method": "opaque"
				}
			},
			"minecraft:light_dampening": 0,
			"minecraft:map_color": "#d3d3d3"
		},
		"permutations": [
			{
				"condition": "q.block_state('minecraft:cardinal_direction') == 'north' ",
				"components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
			},
			{
				"condition": "q.block_state('minecraft:cardinal_direction') == 'south' ",
				"components": { "minecraft:transformation": { "rotation": [0, 0, 0] } }
			},
			{
				"condition": "q.block_state('minecraft:cardinal_direction') == 'east' ",
				"components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
			},
			{
				"condition": "q.block_state('minecraft:cardinal_direction') == 'west' ",
				"components": { "minecraft:transformation": { "rotation": [0, 270, 0] } }
			}
		]
	}
}